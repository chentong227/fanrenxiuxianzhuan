{"name":"韩立","rootId":"si","realmIndex":5,"cultivation":0,"spirit":400,"poolBonus":15,"sense":20,"body":18,"zhuanImprint":1,"hp":175,"hpMax":175,"mood":52,"moodMax":100,"demon":0,"speed":10,"insight":6,"lifespan":110,"age":25,"year":13,"month":13,"stones":0,"silver":32,"location":"tainan_fair","flightId":"none","heroSkin":null,"inventory":{"qingyuan_dan":2,"lingcao":1,"anqi":4,"duyao_cao":7,"lingshi":15,"ningshen_dan":2,"hupi_jinwen":1,"yaodan_1":1,"shougu_bone":2,"jinfu":1,"jinzhong_zhao":1,"jinguang_zhuan":1,"jinguang_zhuan_charge":3,"shengxian_ling":1},"spells":["tuna","huti","ningshen","zhayan","weidu","zhenhun","feizhen"],"technique":"changchun","auxTechniques":[],"learnedTechniques":["changchun"],"techLayers":{"changchun":1},"knownSkills":["tuna","huti","ningshen","zhayan","weidu"],"activeChapter":"qixuan","unlockedChapters":["qixuan","huangfeng"],"flags":{"at_village":true,"joined_sect":true,"met_modafu":true,"met_friends":true,"qi_layer_4":true,"zhangtie_fated":true,"zhangtie_dead":true,"showdown_ready":true,"modafu_dead":true,"got_quhun":true,"is_modafu":true,"gang_war":true,"jinguang_appeared":true,"jinguang_dead":true,"arc1_complete":true,"han_du":true,"han_du_cured":true,"mo_met":true,"mo_warned":true,"quhun_stay_jiayuan":true,"wan_met":true},"firedFortunes":[],"tasks":[{"id":"wolf_raid","dueAbs":164}],"dynQuests":[],"leads":[],"heardLeads":[],"timeline":[],"storyStage":18,"bottle":{"unlocked":true,"plots":[{"crop":null,"growth":0},{"crop":null,"growth":0}]},"fuluPlans":[],"log":[{"id":6,"t":"第9年12月","body":"你在墨大夫药庐遭遇「野狼帮喽啰」，斗法一触即发！","kind":"bad"},{"id":7,"t":"第9年12月","body":"【新任务·山雨欲来】野狼帮气焰嚣张，时有喽啰袭扰。趁早修炼精进（练气六层），方有底气应对将来的大祸。（期限 5 个月）","kind":"event"},{"id":8,"t":"第9年12月","body":"你闭关 8 月，潜心苦修《长春功》。修为+136。","kind":"event"},{"id":9,"t":"第10年1月","body":"心魔未能降伏，灵力逆冲——突破失败！修为-93，气血-26，心魔滋长。","kind":"bad"},{"id":10,"t":"第10年2月","body":"【异闻】采石的力夫慌慌张张跑回镇里，说凿开的岩层里渗出墨绿黏液，腥臭刺鼻——那虫子蜕了壳。","kind":"event"},{"id":11,"t":"第10年2月","body":"灵力冲关，经脉拓宽——你顺势突破至「练气五层」！","kind":"good"},{"id":12,"t":"第10年3月","body":"你动身前往「七玄门后山」，行程耗时 1 月。门派后山，灵草丛生，亦有野兽与低阶修士出没。深入其间，自有采药、机缘与凶险。","kind":"event"},{"id":13,"t":"第10年3月","body":"你拨开后山口的荆棘，雾气扑面而来——再往里，便没有现成的路了。","kind":"event"},{"id":14,"t":"第10年4月","body":"你动身前往「墨大夫药庐」，行程耗时 1 月。你寄身的药庐，也是你潜修的洞府。煎药、辨药、打坐、闭关、冲关，皆在此处。小绿瓶亦藏于此。","kind":"event"},{"id":15,"t":"第10年4月","body":"你将灵草投入小绿瓶培育。","kind":"event"},{"id":16,"t":"第10年5月","body":"【任务·山雨欲来】你迟迟未能精进，野狼帮喽啰摸进药庐寻衅——被迫迎战！","kind":"bad"},{"id":17,"t":"第10年5月","body":"你在墨大夫药庐遭遇「野狼帮喽啰」，斗法一触即发！","kind":"bad"},{"id":18,"t":"第10年5月","body":"【新任务·山雨欲来】野狼帮气焰嚣张，时有喽啰袭扰。趁早修炼精进（练气六层），方有底气应对将来的大祸。（期限 5 个月）","kind":"event"},{"id":19,"t":"第10年5月","body":"你滴入小绿瓶中的神秘绿液，瓶内草木以肉眼可见之速抽长。","kind":"good"},{"id":20,"t":"第10年6月","body":"【异闻】后山一处山坳的草木成片枯黄，地上残留着环节状的拖痕，足有水桶粗细。","kind":"event"},{"id":21,"t":"第10年6月","body":"你滴入小绿瓶中的神秘绿液，瓶内草木以肉眼可见之速抽长。","kind":"good"},{"id":22,"t":"第10年7月","body":"你滴入小绿瓶中的神秘绿液，瓶内草木以肉眼可见之速抽长。","kind":"good"},{"id":23,"t":"第10年7月","body":"小绿瓶催熟之物已成，你收获「灵乳灵药」×1。","kind":"good"},{"id":24,"t":"第10年7月","body":"你服下「灵乳灵药」（修为+60）。","kind":"good"},{"id":25,"t":"第10年8月","body":"你闭关 1 月，潜心苦修《长春功》。修为+8。心绪不宁，杂念丛生，进境大打折扣——该去打坐调息了。","kind":"bad"},{"id":26,"t":"第10年8月","body":"你察觉心绪渐乱，及时收了功——再强撑下去，恐有走火入魔之险。（原拟闭关 36 月，实修 1 月）","kind":"sys"},{"id":27,"t":"第10年9月","body":"你闭关 1 月，潜心苦修《长春功》。修为+8。心绪不宁，杂念丛生，进境大打折扣——该去打坐调息了。","kind":"bad"},{"id":28,"t":"第10年9月","body":"你察觉心绪渐乱，及时收了功——再强撑下去，恐有走火入魔之险。（原拟闭关 31 月，实修 1 月）","kind":"sys"},{"id":29,"t":"第10年10月","body":"【任务·山雨欲来】你迟迟未能精进，野狼帮喽啰摸进药庐寻衅——被迫迎战！","kind":"bad"},{"id":30,"t":"第10年10月","body":"你在墨大夫药庐遭遇「野狼帮喽啰」，斗法一触即发！","kind":"bad"},{"id":31,"t":"第10年10月","body":"【新任务·山雨欲来】野狼帮气焰嚣张，时有喽啰袭扰。趁早修炼精进（练气六层），方有底气应对将来的大祸。（期限 5 个月）","kind":"event"},{"id":32,"t":"第10年10月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":33,"t":"第10年11月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":34,"t":"第10年12月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":35,"t":"第11年1月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":36,"t":"第12年3月","body":"【任务·山雨欲来】你迟迟未能精进，野狼帮喽啰摸进药庐寻衅——被迫迎战！","kind":"bad"},{"id":37,"t":"第12年3月","body":"你在墨大夫药庐遭遇「野狼帮喽啰」，斗法一触即发！","kind":"bad"},{"id":38,"t":"第12年3月","body":"【新任务·山雨欲来】野狼帮气焰嚣张，时有喽啰袭扰。趁早修炼精进（练气六层），方有底气应对将来的大祸。（期限 5 个月）","kind":"event"},{"id":39,"t":"第12年3月","body":"你闭关 1.2 年，潜心苦修《长春功》。修为+266。","kind":"event"},{"id":40,"t":"第12年4月","body":"心魔未能降伏，灵力逆冲——突破失败！修为-103，气血-16，心魔滋长。","kind":"bad"},{"id":41,"t":"第12年5月","body":"【异闻】你在岩缝里拾到一片脱落的铁背甲壳，入手沉重冰凉，叩之铮然有声。它就蛰伏在这下面。","kind":"event"},{"id":42,"t":"第12年5月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":43,"t":"第12年6月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":44,"t":"第12年7月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":45,"t":"第13年3月","body":"【任务·山雨欲来】你迟迟未能精进，野狼帮喽啰摸进药庐寻衅——被迫迎战！","kind":"bad"},{"id":46,"t":"第13年3月","body":"你在墨大夫药庐遭遇「野狼帮喽啰」，斗法一触即发！","kind":"bad"},{"id":47,"t":"第13年3月","body":"【新任务·山雨欲来】野狼帮气焰嚣张，时有喽啰袭扰。趁早修炼精进（练气六层），方有底气应对将来的大祸。（期限 5 个月）","kind":"event"},{"id":48,"t":"第13年3月","body":"你闭关 8 月，潜心苦修《长春功》。修为+136。","kind":"event"},{"id":49,"t":"第13年4月","body":"灵力冲关，经脉拓宽——你顺势突破至「练气六层」！","kind":"good"},{"id":50,"t":"第13年5月","body":"你动身前往「演武厅」，行程耗时 1 月。门中弟子切磋武艺之处。厉飞雨常在此。可与同门切磋、打探门派内外的风声。","kind":"event"},{"id":51,"t":"第13年5月","body":"【结识】你结识了「小算盘」（门中管事弟子）。门中管事弟子，消息灵通。　——已录入「人物图鉴」。","kind":"event"},{"id":52,"t":"第13年5月","body":"【结识】你结识了「贾天龙」（野狼帮帮主）。野狼帮帮主，野心勃勃。　——已录入「人物图鉴」。","kind":"event"},{"id":53,"t":"第13年5月","kind":"story","body":"<div class=\"title\">野狼帮</div><div class=\"seg-scene\">· 数年后 · 演武厅 ·</div><p class=\"seg-narr\">门外早已不太平。野狼帮在帮主贾天龙麾下日渐坐大，为争夺七玄门治下几座富庶城镇的税赋，与门派屡屡冲突，前后交手十余次，互有死伤。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/xiaosuanpan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">小算盘</span><span class=\"dlg-tone\">压低声音</span></div>\n          <div class=\"dlg-text\">墨大夫，您是没瞧见……野狼帮那帮人，一次比一次凶。门里三位师叔都坐不住了。</div>\n        </div>\n      </div><p class=\"seg-aside\">起初不过是凡俗江湖的厮杀。可你嗅到一丝不安——贾天龙的野心，似乎不止于几座城镇。</p><p class=\"seg-narr\">山雨欲来，风满楼。气氛一日紧过一日。</p>"},{"id":54,"t":"第13年5月","body":"【结识】你结识了「金光上人」（青苓修仙杀手）。贾天龙重金请来的修仙杀手。　——已录入「人物图鉴」。","kind":"event"},{"id":55,"t":"第13年5月","kind":"story","body":"<div class=\"title\">金光上人</div><div class=\"seg-scene\">· 七玄门 · 校场 ·</div><p class=\"seg-narr\">果然，贾天龙亮出了底牌——他重金请来一名修仙者：青苓来的矮胖和尚，「金光上人」。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/jinguang.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">金光上人</span><span class=\"dlg-tone\">金光绕身，睥睨众人</span></div>\n          <div class=\"dlg-text\">七玄门？也配？今日，便让尔等见识见识何为仙法。</div>\n        </div>\n      </div><p class=\"seg-narr\">金符、剑符、金钟罩，道道术法璀璨夺目。三位武艺最高的师叔联手而上——</p><div class=\"seg-beat\">——</div><p class=\"seg-narr\">片刻之间，尽数被击倒在地。门派危在旦夕，眼看就要被血洗。</p><p class=\"seg-aside\">满场绝望。可无人知道，这门中还藏着一个修仙者。那就是你——「墨大夫」。</p>"},{"id":56,"t":"第13年5月","kind":"story","body":"<div class=\"title\">暗算金光上人</div><p class=\"seg-aside\">正面硬拼，你绝非这和尚的对手。但修仙之争，从来不是比谁拳头硬——而是比谁算计更深、准备更足、出手更狠。</p><p class=\"seg-narr\">你以「墨大夫」医者的身份从容近身，谁也不会提防一个佝偻的老药师。就在咫尺之间——</p><div class=\"dlg-row right\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--jade-bright)\"><img src=\"assets/portraits/hanli.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--jade-bright)\">韩立</span><span class=\"dlg-tone\">心中默念</span></div>\n          <div class=\"dlg-text\">金钟罩再固，也挡不住由内而发的毒。</div>\n        </div>\n      </div><p class=\"seg-narr\">催熟的剧毒、淬毒的暗器，尽数招呼上去。一击不中，便是粉身碎骨；可一旦得手……</p>"},{"id":57,"t":"第13年5月","body":"金光上人金钟罩护身，寻常攻击难伤分毫！你怀 毒草×7、暗器×10——以毒续伤、以暗器破甲，方有胜机。","kind":"event"},{"id":58,"t":"第13年5月","body":"【勋章】「以下克上」——击败修为高过自己的对手——以弱胜强，此为大勇。（首次达成，载入年表）","kind":"good"},{"id":59,"t":"第13年5月","body":"【名声】「以下克上」的事迹传开——江湖名声 +8（现 33）","kind":"event"},{"id":60,"t":"第13年5月","body":"【复盘】本战关键手：「暗器飞针」共建功 142 伤——你的打法立住了。","kind":"sys"},{"id":61,"t":"第13年5月","body":"金光上人金钟罩虽固，终究敌不过你的毒与暗器。这矮胖和尚至死不信，自己竟栽在一个门派药师手里！七玄门之危，就此解去。","kind":"good"},{"id":62,"t":"第13年5月","body":"【名声】修仙杀手金光上人死于彩霞山——江湖名声 +25（现 58）","kind":"event"},{"id":63,"t":"第13年5月","body":"【风云榜】茶馆酒肆间，你的名号已盖过「厉飞雨（七玄门 · 后起之秀）」。江湖排座次，你又上了一阶。","kind":"good"},{"id":64,"t":"第13年5月","body":"你从他怀中搜出一块巴掌大的金砖，灵光内蕴——正是他赖以成名的符宝「金光砖」！尚余三道充能（灵石可回充）。杀手的凶器，自此是你的底牌。","kind":"good"},{"id":65,"t":"第13年5月","kind":"story","body":"<div class=\"title\">升仙令 · 离门</div><div class=\"seg-scene\">· 七玄门 · 山门外 ·</div><p class=\"seg-narr\">金光上人到死都瞪大着眼——他怎么也想不通，自己竟会折在一个不起眼的门派药师手里。</p><p class=\"seg-narr\">你从他身上搜得宝物：升仙令、金符、剑符、金钟罩——皆是你做梦都不敢想的修仙之资。</p><p class=\"seg-aside\">尤其这枚「升仙令」……它是踏入更高门派、求取筑基机缘的凭证。我的机会，到了。</p><p class=\"seg-narr\">可夜里收功之时，一缕阴寒自丹田窜起，冻得你指尖发麻——墨大夫临死的冷笑浮上心头。遗书里写得明白：他在传你功法时早埋了寒毒，解药唯有墨家祖传的「暖阳宝玉」。</p><p class=\"seg-aside\">遗书末尾是一行小字：去岚州嘉元城墨府，解你的毒，也……替我安顿好她们。这老鬼，到死还要驱使我。</p><p class=\"seg-narr\">你最后回望了一眼这座困了你数年的七玄门。这里有过暖意，也有过欺骗与杀机。</p><div class=\"dlg-row right\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--jade-bright)\"><img src=\"assets/portraits/hanli.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--jade-bright)\">韩立</span><span class=\"dlg-tone\">极轻</span></div>\n          <div class=\"dlg-text\">张铁，飞雨……后会有期。</div>\n        </div>\n      </div><p class=\"seg-narr\">转身，山风扑面。先去嘉元城解毒，再寻修仙人的踪迹——凡人之路，仍在脚下延伸。</p><div class=\"seg-scene\">· 七玄门篇 · 终　——　离门远行 · 启 ·</div>"}],"scenes":[{"id":"gang_conflict","title":"野狼帮","t":"第13年5月","cg":""},{"id":"jinguang_arrives","title":"金光上人","t":"第13年5月","cg":""},{"id":"jinguang_fight","title":"暗算金光上人","t":"第13年5月","cg":"jinguang"},{"id":"arc_end","title":"升仙令 · 离门","t":"第13年5月","cg":"departure"}],"worldNews":[{"t":"第2年10月","kind":"world","text":"听说邻县遭了蝗灾，逃难的人拖家带口往这边来，镇口多了不少生面孔。"},{"t":"第2年12月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气四层。"},{"t":"第3年2月","kind":"breakthrough","text":"传闻：游方·赵越 突破至练气三层。"},{"t":"第3年2月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气二层。"},{"t":"第3年4月","kind":"rumor","text":"坊间闲话：老猎户陈伯进山七八日了，还没见回来。家里人急得直哭。"},{"t":"第3年5月","kind":"rumor","text":"猎户陈伯的草鞋在后山涧边被人寻着了——人多半是没了。山里人叹：靠山吃山，也葬于山。"},{"t":"第3年7月","kind":"rumor","text":"有人说陈伯生前在后山深处拾掇了一片药园，如今成了无主之物……手快有，手慢无。"},{"t":"第3年12月","kind":"rumor","text":"门里传开了：丹房昨夜失窃，丢了一批养元丹。管事们脸色铁青。"},{"t":"第4年2月","kind":"rumor","text":"失窃案有了眉目——竟是个外门弟子监守自盗，已被废了功夫逐出山门。"},{"t":"第4年3月","kind":"rumor","text":"那批赃丹几经转手流入了山下黑市，价钱压得极低。集镇的药贩子们闷声发财。"},{"t":"第5年12月","kind":"rumor","text":"山下风声紧：野狼帮在挨村抽丁，青壮挨家被点名，不从者吃刀背。"},{"t":"第5年12月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气五层。"},{"t":"第5年12月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气三层。"},{"t":"第5年12月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气五层。"},{"t":"第6年2月","kind":"rumor","text":"商路被野狼帮的关卡掐断了，集镇物价一日三涨，镖局的买卖也歇了。"},{"t":"第6年7月","kind":"rumor","text":"镖局贴出悬赏：剿杀野狼帮喽啰者，赏银十二两——刀口舔血的营生，干不干？"},{"t":"第8年1月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气六层。"},{"t":"第8年1月","kind":"fortune","text":"传言后山那头「白额吊睛虎」已被门中一位弟子毙杀，山民拍手称快——据说是药庐那位韩师傅。"},{"t":"第8年3月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气六层。"},{"t":"第9年1月","kind":"breakthrough","text":"传闻：散修·冯婆婆 突破至练气八层。"},{"t":"第9年2月","kind":"world","text":"夜里落了头场霜，门中老人说，今年的冬天会比往年冷。"},{"t":"第9年12月","kind":"world","text":"几名外门弟子因私斗被罚去担水三月，门规面前没人讲情面。"},{"t":"第9年12月","kind":"breakthrough","text":"传闻：散修·王矮子 突破至练气六层。"},{"t":"第9年12月","kind":"breakthrough","text":"传闻：黄枫散人·周牧 突破至练气九层。"},{"t":"第12年3月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气七层。"},{"t":"第12年3月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气四层。"}],"npcFates":[{"id":"s_li","name":"散修·李恒","apt":1.05,"realm":6,"cul":148.88141976012247,"age":50.333333333333684,"lifespan":120,"status":"alive","desperate":fal