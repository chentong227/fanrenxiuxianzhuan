{
  "mcpServers": {
    "playwright": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--allow-unrestricted-file-access"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_take_screenshot",
        "browser_snapshot",
        "browser_click",
        "browser_resize",
        "browser_evaluate",
        "browser_wait_for",
        "browser_console_messages",
        "browser_close"
      ]
    }
  }
}