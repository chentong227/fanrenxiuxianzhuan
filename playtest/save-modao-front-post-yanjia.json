{"name":"韩立","rootId":"si","realmIndex":13,"cultivation":0,"spirit":27,"poolBonus":9,"sense":19,"body":17,"zhuanImprint":1,"hp":170,"hpMax":170,"mood":100,"moodMax":100,"demon":20,"speed":10,"insight":10,"lifespan":190,"age":89,"year":79,"month":4,"stones":0,"silver":56,"location":"modao_front","flightId":"shen_feng_zhou","inventory":{"qingyuan_dan":2,"ducao":5,"lingshi":27,"ningshen_dan":2,"duyao_cao":7,"jinfu":1,"jinzhong_zhao":1,"jinguang_zhuan":1,"shengxian_ling":1,"nuanyang_yu":1,"changchun_houpian":1,"lingcao":2,"waimen_tiejian":1,"mojiao_lin":2,"zhuji_dan":11,"wulong_duo":1,"wuxing_zhen":1},"spells":["tuna","huti","ningshen","zhayan","weidu","qingyuan_jianmang","jujian_shu"],"technique":"qingyuan_sword","auxTechniques":["changchun"],"learnedTechniques":["changchun","changchun_full","qingyuan_sword"],"techLayers":{"changchun":1,"changchun_full":1,"qingyuan_sword":3},"knownSkills":["tuna","huti","ningshen","zhayan","weidu","huodan","qingyuan_jianmang","jujian_shu"],"activeChapter":"modao","unlockedChapters":["qixuan","huangfeng","modao"],"flags":{"at_village":true,"joined_sect":true,"met_modafu":true,"zhangtie_fated":true,"zhangtie_dead":true,"showdown_ready":true,"losses_showdown":1,"modafu_dead":true,"showdown_won":true,"got_quhun":true,"is_modafu":true,"gang_war":true,"jinguang_appeared":true,"jinguang_dead":true,"arc1_complete":true,"han_du":true,"mo_met":true,"mo_months":2,"mo_warned":true,"han_du_cured":true,"wan_met":true,"fair_bought":1,"qingwen_seen":true,"xianhui_due":21,"wan_hunt_done":true,"xianhui_done":true,"losses_revenge":2,"revenge_prepped":true,"wan_avenged":true,"departure_complete":true,"huangfeng_entered":true,"hf_arrived":true,"zhuji_dan_stolen":true,"zhangmen_seen":true,"yaoyuan_started":true,"xueshi_due":54,"fangshi_visited":2,"losses_luyunfeng":1,"luyunfeng_dead":true,"xueshi_opened":true,"jindi_entered":true,"mojiao_slain":true,"jindi_left":true,"adventured":true,"mojiao_resolved":true,"nangongwan_bond":true,"zhuji_lian_done":true,"qingyuan_given":true,"dongfu_done":true,"dongfu_type":"lingquan","daigong_done":true,"huangfeng_complete":true,"yanjia_summoned":true,"yanjia_reunion_done":true,"mocaihuan_reunion":true,"losses_zhanwangchan":2,"yanjia_boss_done":true,"yanjia_done":true,"modao_conscripted":true,"modao_call_due":954},"firedFortunes":[],"tasks":[],"dynQuests":[],"leads":[],"heardLeads":[],"timeline":[],"storyStage":43,"bottle":{"unlocked":false,"plots":[]},"log":[{"id":281,"t":"第74年6月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":282,"t":"第74年7月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":283,"t":"第74年8月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":284,"t":"第74年9月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":285,"t":"第76年5月","body":"你闭关 1.7 年，潜心苦修《长春功》。修为+380。","kind":"event"},{"id":286,"t":"第76年5月","body":"闭关插曲·外扰：静室之外似有动静，你不得不分神戒备，这一程闭关被搅得难以尽兴。","kind":"sys"},{"id":287,"t":"第76年5月","body":"你察觉心绪渐乱，及时收了功——再强撑下去，恐有走火入魔之险。（原拟闭关 36 月，实修 20 月）","kind":"sys"},{"id":288,"t":"第76年6月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":289,"t":"第76年7月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":290,"t":"第76年8月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":291,"t":"第76年9月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":292,"t":"第76年10月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":293,"t":"第76年11月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":294,"t":"第78年8月","body":"你闭关 1.8 年，潜心苦修《长春功》。修为+399。","kind":"event"},{"id":295,"t":"第78年8月","body":"你察觉心绪渐乱，及时收了功——再强撑下去，恐有走火入魔之险。（原拟闭关 36 月，实修 21 月）","kind":"sys"},{"id":296,"t":"第78年9月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":297,"t":"第78年10月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":298,"t":"第78年11月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":299,"t":"第78年12月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":300,"t":"第79年1月","body":"你盘膝打坐，调息养神。灵力、气血与心境皆有恢复。","kind":"event"},{"id":301,"t":"第79年2月","body":"你按秘仪引动天地之力冲击「筑基初期」之关，生平执念尽数化作心魔劫扑面而来——成败、生死，皆在此一战！","kind":"event"},{"id":302,"t":"第79年2月","body":"【复盘】本战关键手：「御剑刺」共建功 72 伤——你的打法立住了。","kind":"sys"},{"id":303,"t":"第79年2月","body":"心魔劫已渡！你脱胎换骨，正式跻身「筑基初期」——这一步，多少修士求而不得。","kind":"good"},{"id":304,"t":"第79年2月","body":"【因果有报】入谷那日被夺走的东西，你用二十颗丹与一个境界，彻底讨了回来（因起于第1年12月：入谷之日，叶师叔借调解之名换走你的筑基丹（陆云风发难在先））","kind":"good"},{"id":305,"t":"第79年2月","kind":"story","body":"<div class=\"title\">筑基 · 青元剑诀</div><div class=\"seg-scene\">· 黄枫谷 · 山门大殿 ·</div><p class=\"seg-narr\">筑基的消息传开那日，整个百药园都炸了——四灵根伪灵根筑基，黄枫谷立谷以来，数得出几个？</p><p class=\"seg-narr\">李化元把你唤去丹房，案上摊着一卷泛黄的剑诀。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/lihuayuan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">李化元</span></div>\n          <div class=\"dlg-text\">长春功到头了。筑基之后主修须换——这卷《青元剑诀》，谷中流传九层，弟子多止步三层。以你的心性，不止于此。</div>\n        </div>\n      </div><p class=\"seg-narr\">你双手接过。卷册入手微沉，翻开第一页，一缕青芒自纸面流过——青芒可凝成三尺剑芒，亦可聚作丈余巨剑，自天倾斩。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/lihuayuan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">李化元</span><span class=\"dlg-tone\">soft</span></div>\n          <div class=\"dlg-text\">去吧。把它练出名堂来——别辜负你那二十颗丹。</div>\n        </div>\n      </div><p class=\"seg-aside\">十九颗碎在丹田里，最后一颗成了。筑基这条路，是拿命堆出来的——往后的路，更是。</p>"},{"id":306,"t":"第79年2月","kind":"story","body":"<div class=\"title\">洞府 · 安身之地</div><div class=\"seg-scene\">· huangfeng_gate ·</div><p class=\"seg-narr\">筑基弟子，有开洞府之权。掌门殿发下三处可选之地的图册，附赠一面「迷踪阵旗」——这是规制内的体面。</p><p class=\"seg-aside\">杂役棚里睡了三年，如今也轮到自己择一处山头了。</p>"},{"id":307,"t":"第79年2月","body":"【因果】择灵泉眼开洞府（修炼效率+），驱走了占洞的灵猿——此事已了，但未必就此了结。","kind":"sys"},{"id":308,"t":"第79年2月","body":"你提剑上山，洞中盘踞的白毛灵猿与你斗了半日，终是不敌，呜咽着让出泉眼。\n\n泉水叮咚，灵气氤氲——你的第一座洞府，悬在黄枫谷的云雾里。自此闭关修炼，事半功倍（修炼效率+15%）。","kind":"good"},{"id":309,"t":"第79年3月","body":"你动身前往「元武国 · 百艺坊」，行程耗时 1 月。太岳山脉那头的邻国，比胥国更尚武，炼器炉火彻夜不熄。坊市街尾那间「百艺坊」招牌不大，名头却响——巧匠齐云霄一炉好风火，墨蛟皮、千年灵草这等好料，到了他手里才不算糟蹋。","kind":"event"},{"id":310,"t":"第79年3月","body":"【结识】你结识了「齐云霄」（元武国 · 百艺坊巧匠）。元武国百艺坊的巧匠，一炉好风火——墨蛟皮、千年灵草这等好料，到他手里方不算糟蹋。　——已录入「人物图鉴」。","kind":"event"},{"id":311,"t":"第79年3月","body":"【因果】北上元武国百艺坊，会巧匠齐云霄代工——首访不遇辛如音——此事已了，但未必就此了结。","kind":"sys"},{"id":312,"t":"第79年3月","kind":"story","body":"<div class=\"title\">代工 · 百艺坊巧匠</div><div class=\"seg-scene\">· 元武国 · 百艺坊 ·</div><p class=\"seg-narr\">出黄枫谷北行，过太岳山脉，便是元武国——比胥国更尚武的邻邦。坊市街尾那间「百艺坊」招牌不大，炉火却彻夜不熄。</p><p class=\"seg-narr\">你解下行囊里那一捆血色禁地的战利品：墨蛟之皮、之鳞、之角，腥气未散。柜后转出一个精瘦汉子，三角眼往那堆料上一扫，先是一亮，随即慢条斯理敲起算盘。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait\" style=\"--pc:var(--ink)\">🧑</div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">齐云霄</span></div>\n          <div class=\"dlg-text\">墨蛟的料？啧——好东西，到了旁人手里是糟蹋。皮可裁帆、角可炼钩、鳞可衬骨。小兄弟，是要快、要狠，还是要稳？</div>\n        </div>\n      </div><div class=\"dlg-row right\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--jade-bright)\"><img src=\"assets/portraits/hanli_zhuji.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--jade-bright)\">韩立</span></div>\n          <div class=\"dlg-text\">都要。</div>\n        </div>\n      </div><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait\" style=\"--pc:var(--ink)\">🧑</div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">齐云霄</span></div>\n          <div class=\"dlg-text\">痛快！那便一炉三件：神风舟载你赶路，乌龙夺替你搏命；再奉送一张护阵的图——颠倒五行阵，基础的式子，我那口千年灵草的老底，匀你一份作引。</div>\n        </div>\n      </div><p class=\"seg-aside\">坊里似乎还该有个掌账的女子打理这些，却始终不见人影。齐云霄只字未提，你也没多问——有些人，要等再来一趟，才遇得上。</p>"},{"id":313,"t":"第79年3月","body":"【因果】墨蛟之料托元武国齐云霄炼成三件大件——神风舟、乌龙夺、颠倒五行阵基础版——此事已了，但未必就此了结。","kind":"sys"},{"id":314,"t":"第79年3月","body":"炉火三日不熄。再开炉时——\n\n· 乌龙夺（御物·破甲水属攻击法宝——继金蚨子母刃后的筑基主战法器）\n· 神风舟（御风疾驰的小舟形法器——前期赶路全靠它）\n· 颠倒五行阵图·基础版（洞府护阵——他日魔道重逢齐云霄，可加强为「真·颠倒五行阵」）\n\n齐云霄拍去掌上的灰：「拿好。墨蛟没白杀，你也没白来这一趟。」","kind":"good"},{"id":315,"t":"第79年4月","body":"你动身前往「黄枫谷 · 外门居所」，行程耗时 1 月。太岳山脉深处的仙家洞天。你领了外门弟子的居所与一身青衫——百药园的差事、筑基丹的恩怨，都在前头等着。","kind":"event"},{"id":316,"t":"第79年4月","body":"【因果】叶师叔遗物中那卷「大衍诀」残卷，归档在执法堂库房——你记住了——此事已了，但未必就此了结。","kind":"sys"},{"id":317,"t":"第79年4月","kind":"story","body":"<div class=\"title\">尾声 · 叶师叔之报</div><div class=\"seg-scene\">· 黄枫谷 · 山门大殿 ·</div><p class=\"seg-narr\">你筑基后第三个月，黄枫谷出了大事。</p><p class=\"seg-narr\">执法堂深夜锁拿叶师叔——罪名是「私通魔道」。卷宗上写得分明：千竹教卧底，潜伏二十年，入谷四连里被他夺走的那枚筑基丹，早顺着暗线送去了魔道。</p><p class=\"seg-aside\">当日满殿无人敢言的那位叶师叔……原来掌门的「不主持公道」，背后还有这一层。</p><p class=\"seg-narr\">可惜执法堂晚了一步。叶师叔越狱遁走，三日后，尸身在谷外百里的乱石滩上被发现——出手的是路过的散修雷万鹤，一击毙命。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/mashibo.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">马师伯</span><span class=\"dlg-tone\">soft</span></div>\n          <div class=\"dlg-text\">千竹教的人，死在自己买凶的路上。报应这东西，从来不缺席，只是不挑时辰。</div>\n        </div>\n      </div><p class=\"seg-narr\">执法堂清点叶师叔洞府时，搜出的赃物里有一卷无人能识的功法残卷——神识一触，深奥得叫人头痛。卷首两个古字：大衍。</p><p class=\"seg-aside\">「大衍诀」……执法堂当它是废卷归档了。可那一眼，你记住了——总有一天，它会是你的。</p>"},{"id":318,"t":"第79年4月","body":"【因果】李化元强制调令——征调伪灵根筑基的你赴燕家堡，正道七派会盟御魔——此事已了，但未必就此了结。","kind":"sys"},{"id":319,"t":"第79年4月","kind":"story","body":"<div class=\"title\">魔道争锋篇·前置 · 燕家堡调令</div><div class=\"seg-scene\">· 黄枫谷 · 外门居所 ·</div><p class=\"seg-narr\">大衍诀的事还压在心头，谷中一道加急调令便到了你手上——朱漆封口，落款是首席大长老李化元。</p><p class=\"seg-narr\">「魔道入侵在即。天南正道七派会盟燕家堡，共御魔锋。凡谷中筑基弟子，无论灵根，尽数征调——三日内动身。」</p><p class=\"seg-aside\">无论灵根。这四个字，分明是冲着你这伪灵根来的。修为压制，军令如山——这一回，没有「不去」的选项。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/lihuayuan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">李化元</span><span class=\"dlg-tone\">cold</span></div>\n          <div class=\"dlg-text\">你筑基了，便是谷中战力。燕家堡那一战躲不过，与其日后被人推上去送死，不如老夫先把你这条命，用在该用的地方。</div>\n        </div>\n      </div><p class=\"seg-narr\">你收拾起神风舟、乌龙夺与那张颠倒五行阵图，望了一眼太岳山脉北面那片越来越浓的妖氛——天南，真的要变天了。</p>"},{"id":320,"t":"第79年4月","body":"【结识】你结识了「董萱儿」（红拂门下 · 名门之后）。红拂门下名门之后——陆云风当年为攀附她而痛下杀手；燕家堡之战中与你并肩御魔。　——已录入「人物图鉴」。","kind":"event"},{"id":321,"t":"第79年4月","body":"【因果】燕家堡重逢墨彩环、结识董萱儿——魔道入侵下的故人与名门——此事已了，但未必就此了结。","kind":"sys"},{"id":322,"t":"第79年4月","body":"陈家的人也在堡中——为陆云风一事，陈巧倩那一脉暗中给你递来一囊疗伤丹药，未发一言。这份人情，你记下了。","kind":"event"},{"id":323,"t":"第79年4月","kind":"story","body":"<div class=\"title\">燕家堡 · 故人重逢</div><div class=\"seg-scene\">· 燕家堡 · 堡内校场 ·</div><p class=\"seg-narr\">燕家堡——天南正道七派临时会盟的大堡，堡墙旌旗猎猎，堡内却人心惶惶。（这里是燕家，可不是天阙堡——那是更往后的事了。）</p><p class=\"seg-narr\">你正寻自己的战位，一道熟悉的身影从避难的墨府家眷中迎面撞来——竟是墨彩环。嘉元城一别，她眉眼间已添了几分风霜。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/mocaihuan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">墨彩环</span></div>\n          <div class=\"dlg-text\">韩大哥……真的是你。魔道打过来，爹让我们随墨府避进堡里。你……你也来了。这回，可别又把人丢下不管。</div>\n        </div>\n      </div><p class=\"seg-narr\">校场另一头，一位眉眼高华的红拂门下女修按剑而立，目光在你那柄乌龙夺上停了一瞬——后来你才知她姓董，名萱儿。当年陆云风为攀附的，正是她这条线。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait\" style=\"--pc:var(--ink)\">🧑</div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">董萱儿</span><span class=\"dlg-tone\">cold</span></div>\n          <div class=\"dlg-text\">伪灵根能筑基，倒是稀奇。战王蝉就要破阵了——活着出了这堡，再论你够不够格同我说话。</div>\n        </div>\n      </div>"},{"id":325,"t":"第79年4月","body":"你在燕家堡遭遇「战王蝉」，斗法一触即发！","kind":"bad"},{"id":327,"t":"第79年4月","body":"你在燕家堡遭遇「战王蝉」，斗法一触即发！","kind":"bad"},{"id":328,"t":"第79年4月","body":"「曲魂」在战斗中损毁严重，再难驱使——回药庐以毒物阴材温养修缮，方可复原。","kind":"bad"},{"id":329,"t":"第79年4月","body":"【复盘】你倒在「战王蝉」的「金鸣音波」之下。记住这一招——它不会再得手第二次。","kind":"sys"},{"id":330,"t":"第79年4月","body":"战王蝉势大如崩山，你浴血退守、就地整顿（再战伤害+8%）。这一蝉不死不休——你不退，它更不会退。调息再上！","kind":"bad"},{"id":332,"t":"第79年4月","body":"你在燕家堡遭遇「战王蝉」，斗法一触即发！","kind":"bad"},{"id":333,"t":"第79年4月","body":"【复盘】你倒在「战王蝉」的「振翅冲撞」之下。记住这一招——它不会再得手第二次。","kind":"sys"},{"id":334,"t":"第79年4月","body":"战王蝉势大如崩山，你浴血退守、就地整顿（再战伤害+16%）。这一蝉不死不休——你不退，它更不会退。调息再上！","kind":"bad"},{"id":335,"t":"第79年4月","kind":"story","body":"<div class=\"title\">燕家堡之战 · 战王蝉破阵</div><div class=\"seg-scene\">· 燕家堡 · 堡墙血夜 ·</div><p class=\"seg-narr\">妖氛冲天，堡墙轰然炸裂——魔道巨擘战王蝉破阵而出！甲胄如铁，双镰开阖，振翅之间裂石分风，正道修士成片倒下。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait\" style=\"--pc:var(--ink)\">🧑</div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">董萱儿</span><span class=\"dlg-tone\">cold</span></div>\n          <div class=\"dlg-text\">它的目标是堡心！挡不住它，今夜谁也活不成——韩立，你那柄破甲的钩子，该出鞘了！</div>\n        </div>\n      </div><p class=\"seg-aside\">诛它？这等魔道巨擘岂是今日的你能诛的。撑过它的杀势、活着退出燕家堡——这一战，只为这一个字：活。</p>"},{"id":336,"t":"第79年4月","body":"你在燕家堡遭遇「战王蝉」，斗法一触即发！","kind":"bad"},{"id":337,"t":"第79年4月","body":"【复盘】本战关键手：「眨眼剑法」共建功 176 伤——你的打法立住了。","kind":"sys"},{"id":338,"t":"第79年4月","body":"你击退了「战王蝉」。","kind":"good"},{"id":339,"t":"第79年4月","body":"【结识】你结识了「战王蝉」（魔道巨擘 · 不死宿敌）。燕家堡破阵的魔道巨擘——重伤遁空，与你结下不死不休之仇。　——已录入「人物图鉴」。","kind":"event"},{"id":340,"t":"第79年4月","body":"【因果】燕家堡之战力挫战王蝉——魔道巨擘重伤遁空，与你结下不死不休之仇——此事已了，但未必就此了结。","kind":"sys"},{"id":341,"t":"第79年4月","body":"战王蝉甲胄迸裂、振翅遁空——这等魔道巨擘岂是一战可诛？它临去前那一眼死死咬住你的气息：不死不休。这一关，你撑过来了。","kind":"event"},{"id":342,"t":"第79年4月","body":"【因果】逃出燕家堡，被七派强征入伍——编入魔道争锋前线待命营，听候征调——此事已了，但未必就此了结。","kind":"sys"},{"id":343,"t":"第79年4月","kind":"story","body":"<div class=\"title\">燕家堡 · 逃出生天</div><div class=\"seg-scene\">· 燕家堡 · 溃围 ·</div><p class=\"seg-narr\">战王蝉重伤遁空，可燕家堡也守不住了。堡墙四面起火，正道修士护着家眷夺路突围——你断后掩护，护着墨彩环、随董萱儿杀出一条血路。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait has-img\" style=\"--pc:var(--ink)\"><img src=\"assets/portraits/mocaihuan.png?v=28\" alt=\"\" loading=\"lazy\" /></div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">墨彩环</span></div>\n          <div class=\"dlg-text\">你又要走了……我知道你拦不住自己。可你得活着——答应我。</div>\n        </div>\n      </div><p class=\"seg-narr\">堡外，七派会盟的执旗使早已等在那里。一面「征」字大旗压下来——凡今夜活着出堡的筑基修士，尽数编入魔道争锋的战阵，即刻开赴前线。</p><div class=\"dlg-row left\">\n        <div class=\"dlg-portrait\" style=\"--pc:var(--ink)\">🧑</div>\n        <div class=\"dlg-bubble\">\n          <div class=\"dlg-who\"><span class=\"dlg-name\" style=\"color:var(--ink)\">执旗使</span><span class=\"dlg-tone\">cold</span></div>\n          <div class=\"dlg-text\">活下来的，都是战力。黄枫谷韩立——编入前线待命营，听候征调。魔道争锋，才刚开始。</div>\n        </div>\n      </div><p class=\"seg-aside\">你回头望了一眼火光里的燕家堡。这一战撑过来了，可真正的修罗场，是前头那一片不知尽头的矿道与杀阵。</p>"}],"worldNews":[{"t":"第31年3月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气七层。"},{"t":"第31年3月","kind":"breakthrough","text":"传闻：散修·王矮子 突破至练气八层。"},{"t":"第35年8月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气九层。"},{"t":"第35年8月","kind":"breakthrough","text":"传闻：七玄弟子·孙礼 突破至练气九层。"},{"t":"第35年11月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气九层。"},{"t":"第38年2月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气八层。"},{"t":"第40年4月","kind":"breakthrough","text":"传闻：游方·赵越 突破至练气七层。"},{"t":"第40年6月","kind":"breakthrough","text":"传闻：黄枫散人·周牧 突破至练气十三层。"},{"t":"第42年6月","kind":"world","text":"市集上新到了一批南边的药材，价钱压得很低，药铺掌柜们脸色难看。"},{"t":"第44年9月","kind":"breakthrough","text":"传闻：散修·冯婆婆 突破至练气十层。"},{"t":"第44年9月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气九层。"},{"t":"第44年9月","kind":"breakthrough","text":"传闻：游方·赵越 突破至练气八层。"},{"t":"第46年11月","kind":"ascend","text":"喜讯：黄枫散人·周牧 历尽艰辛，竟成功筑基！自此寿元大增，超脱凡俗之列。"},{"t":"第46年11月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气十层。"},{"t":"第46年12月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气十层。"},{"t":"第49年2月","kind":"breakthrough","text":"传闻：散修·王矮子 突破至练气九层。"},{"t":"第49年2月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气十层。"},{"t":"第51年5月","kind":"world","text":"听说邻县遭了蝗灾，逃难的人拖家带口往这边来，镇口多了不少生面孔。"},{"t":"第53年7月","kind":"breakthrough","text":"传闻：散修·冯婆婆 突破至练气十一层。"},{"t":"第55年9月","kind":"breakthrough","text":"传闻：游方·赵越 突破至练气九层。"},{"t":"第55年9月","kind":"breakthrough","text":"传闻：散修·王矮子 突破至练气十层。"},{"t":"第57年11月","kind":"world","text":"山道上的老茶棚换了新主人，旧主人据说进山采药，再没回来。"},{"t":"第59年3月","kind":"world","text":"几名外门弟子因私斗被罚去担水三月，门规面前没人讲情面。"},{"t":"第59年4月","kind":"world","text":"市集上新到了一批南边的药材，价钱压得很低，药铺掌柜们脸色难看。"},{"t":"第61年3月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气十一层。"},{"t":"第61年3月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气十一层。"},{"t":"第61年4月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气十一层。"},{"t":"第63年5月","kind":"breakthrough","text":"传闻：七玄弟子·孙礼 突破至练气十层。"},{"t":"第68年2月","kind":"breakthrough","text":"传闻：七玄弟子·钱通 突破至练气十二层。"},{"t":"第69年11月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气十二层。"},{"t":"第69年11月","kind":"breakthrough","text":"传闻：散修·陈九 突破至练气十二层。"},{"t":"第69年11月","kind":"breakthrough","text":"传闻：黄枫散人·周牧 突破至筑基期以上。"},{"t":"第74年4月","kind":"breakthrough","text":"传闻：散修·王矮子 突破至练气十一层。"},{"t":"第74年9月","kind":"breakthrough","text":"传闻：七玄弟子·孙礼 突破至练气十一层。"},{"t":"第76年5月","kind":"breakthrough","text":"传闻：散修·李恒 突破至练气十三层。"},{"t":"第76年5月","kind":"desperate","text":"散修·冯婆婆（练气十一层）寿元将尽，仍未能突破，开始四处求丹、欲闯秘境搏一线生机。"},{"t":"第76年6月","kind":"breakthrough","text":"传闻：游方·赵越 突破至练气十层。"},{"t":"第78年8月","kind":"world","text":"门中贴出告示：后山深处近来有凶兽伤人，弟子结伴方可入山。"},{"t":"第78年8月","kind":"sys","text":"听闻：散修·冯婆婆 苦求丹药而不得，徒叹奈何。"},{"t":"第78年8月","kind":"breakthrough","text":"传闻：黄枫散人·周牧 